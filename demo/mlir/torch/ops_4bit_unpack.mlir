func.func @test_int4(%arg0: tensor<2x1024xf16>) -> tensor<128x2048x2xi8>
{
    %1 = "arith.constant"() {value=dense_resource<block_scale> : tensor<128x2048xi8>} : () -> tensor<128x2048xi8>
    %empty = tensor.empty() : tensor<128x2048x2xi8>
    %2 = linalg.generic { indexing_maps = [
            affine_map<(d0, d1, d2) -> (d0, d1)>,
            affine_map<(d0, d1, d2) -> (d0, d1, d2)>
        ],
        iterator_types = [
            "parallel", "parallel", "parallel"
        ] }
        ins (%1 : tensor<128x2048xi8>)
        outs (%empty : tensor<128x2048x2xi8>){
        ^bb0(%in: i8, %out: i8):
            %15 = "arith.constant"() <{value = 15 : i8}> : () -> i8
            %4 = "arith.constant"() <{value = 4 : i8}> : () -> i8

            %i = linalg.index 2 : index
            %i_i1 = arith.index_cast %i : index to i1

            %t0 = arith.shli %in, %4 : i8
            %t1 = arith.shrsi %t0, %4 : i8
            %t2 = arith.shrsi %in, %4 : i8

            %t3 = arith.select %i_i1, %t2, %t1 : i8

            linalg.yield %t3: i8
        } -> tensor<128x2048x2xi8>


    func.return %2 : tensor<128x2048x2xi8>
}

